# CRAFT-Sec environment variables.
# Copy this file to .env for local development. Never commit real secrets.
# Setup creates .env from this template automatically if it does not exist.
# No model or dataset is downloaded by setup, doctor, lint, or tests.

# --- Runtime ---------------------------------------------------------------
CRAFTSEC_LOG_LEVEL=INFO
CRAFTSEC_DATA_DIR=./.craftsec-data
CRAFTSEC_LOG_DIR=./.craftsec-data/logs

# --- HTTP API --------------------------------------------------------------
# Local-first defaults. Keep the loopback bind unless the deployment is
# intentionally isolated. Port 0 selects an ephemeral port.
CRAFTSEC_HOST=127.0.0.1
CRAFTSEC_PORT=8765

# CORS is disabled by default. Set an exact comma-separated allowlist when a
# local UI needs browser access. Wildcards are rejected.
# CRAFTSEC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Workspace roots allowed for file and workspace scans. Defaults to the process
# working directory. Paths outside this allowlist are rejected.
# CRAFTSEC_WORKSPACE_ROOTS=.

# Request and scan limits.
CRAFTSEC_MAX_REQUEST_BYTES=2097152
CRAFTSEC_MAX_FILE_BYTES=1048576
CRAFTSEC_MAX_WORKSPACE_FILES=50000

# Optional bearer token for /api/* requests. Generate a local random value and
# never commit it. Leave unset for loopback-only development.
# CRAFTSEC_API_TOKEN=

# --- Model runtime ---------------------------------------------------------
# CPU-only development is the safe default. Use "auto" to detect CUDA/MPS,
# or set "cuda" / "mps" explicitly when the required hardware is available.
CRAFTSEC_DEVICE=cpu
CRAFTSEC_GPU_CONCURRENCY=1

# Optional: model identifier and immutable revision. Leave these commented out
# until a workflow explicitly needs a model; setup never downloads weights.
# CRAFTSEC_MODEL_ID=Qwen/Qwen2.5-Coder-1.5B-Instruct
# CRAFTSEC_MODEL_REVISION=<commit-sha>

# Optional: access token for gated Hugging Face models. Leave commented out
# unless a gated model is intentionally used. The token is redacted from logs.
# CRAFTSEC_HF_TOKEN=

# --- SAE artifacts ---------------------------------------------------------
# Optional: path to a registered, compatible SAE artifact manifest.
# Never point this at a simulated or incompatible SAE.
# CRAFTSEC_SAE_MANIFEST=./.craftsec-data/sae/manifest.json

# --- Verification sandbox --------------------------------------------------
# Allowed values: docker, process, none. Execution verification requires docker.
CRAFTSEC_SANDBOX_BACKEND=docker
CRAFTSEC_SANDBOX_TIMEOUT_SECONDS=900

# --- Analyzers -------------------------------------------------------------
CRAFTSEC_SEMGREP_PATH=semgrep
CRAFTSEC_BANDIT_PATH=bandit
# CRAFTSEC_CODEQL_PATH=
# CRAFTSEC_JOERN_PATH=
