{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://craftsec.local/schemas/v1/explanation-result.json",
  "title": "ExplanationResult",
  "description": "An evidence-grounded explanation. Each claim retains its kind and evidence; an unavailable analysis must not contain claims or a graph.",
  "type": "object",
  "required": ["analysisAvailable", "claims", "limitations"],
  "properties": {
    "analysisAvailable": {
      "type": "boolean"
    },
    "findingId": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 10000
    },
    "claims": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/Claim"
      }
    },
    "graph": {
      "oneOf": [
        {
          "$ref": "#/$defs/Graph"
        },
        {
          "type": "null"
        }
      ]
    },
    "limitations": {
      "$ref": "common.json#/$defs/Limitations"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Claim": {
      "type": "object",
      "required": ["claimId", "claimKind", "text", "evidenceSources"],
      "properties": {
        "claimId": {
          "$ref": "common.json#/$defs/Identifier"
        },
        "claimKind": {
          "$ref": "common.json#/$defs/ClaimKind"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "evidenceSources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "common.json#/$defs/EvidenceSource"
          }
        },
        "provenance": {
          "$ref": "common.json#/$defs/Provenance"
        }
      },
      "additionalProperties": false
    },
    "Graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/Edge"
          }
        }
      },
      "additionalProperties": false
    },
    "Node": {
      "type": "object",
      "required": ["id", "kind", "label", "claimKind"],
      "properties": {
        "id": {
          "$ref": "common.json#/$defs/Identifier"
        },
        "kind": {
          "enum": ["finding", "evidence", "feature", "intervention", "verification"]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "claimKind": {
          "$ref": "common.json#/$defs/ClaimKind"
        },
        "provenance": {
          "$ref": "common.json#/$defs/Provenance"
        }
      },
      "additionalProperties": false
    },
    "Edge": {
      "type": "object",
      "required": ["from", "to", "kind"],
      "properties": {
        "from": {
          "$ref": "common.json#/$defs/Identifier"
        },
        "to": {
          "$ref": "common.json#/$defs/Identifier"
        },
        "kind": {
          "enum": ["supports", "contradicts", "derived_from", "verified_by"]
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "analysisAvailable": {
            "const": false
          }
        },
        "required": ["analysisAvailable"]
      },
      "then": {
        "type": "object",
        "properties": {
          "claims": {
            "type": "array",
            "maxItems": 0
          },
          "graph": {
            "type": "null"
          }
        }
      }
    }
  ]
}
