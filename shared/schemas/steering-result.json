{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://craftsec.local/schemas/v1/steering-result.json",
  "title": "SteeringResult",
  "description": "An activation-steering plan and its limited evaluation. A plan is only valid with explicit opt-in; an unavailable result must not contain a plan.",
  "type": "object",
  "required": ["analysisAvailable", "plan", "guardrails", "limitations"],
  "properties": {
    "analysisAvailable": {
      "type": "boolean"
    },
    "plan": {
      "oneOf": [
        {
          "$ref": "#/$defs/Plan"
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluation": {
      "oneOf": [
        {
          "$ref": "#/$defs/Evaluation"
        },
        {
          "type": "null"
        }
      ]
    },
    "guardrails": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 5000
      }
    },
    "limitations": {
      "$ref": "common.json#/$defs/Limitations"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Plan": {
      "type": "object",
      "required": ["featureIndices", "strength", "targetMetric", "explicitOptIn"],
      "properties": {
        "featureIndices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "targetMetric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "explicitOptIn": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "Evaluation": {
      "type": "object",
      "required": ["before", "after", "delta", "valid"],
      "properties": {
        "before": {
          "type": ["number", "null"]
        },
        "after": {
          "type": ["number", "null"]
        },
        "delta": {
          "type": ["number", "null"]
        },
        "valid": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "analysisAvailable": {
            "const": true
          }
        },
        "required": ["analysisAvailable"]
      },
      "then": {
        "type": "object",
        "properties": {
          "plan": {
            "$ref": "#/$defs/Plan"
          }
        },
        "required": ["plan"]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "analysisAvailable": {
            "const": false
          }
        },
        "required": ["analysisAvailable"]
      },
      "then": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "null"
          },
          "evaluation": {
            "type": "null"
          }
        }
      }
    }
  ]
}
