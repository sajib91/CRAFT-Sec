{
  "name": "craft-sec",
  "displayName": "CRAFT-Sec Security Framework",
  "description": "Explainable vulnerability analysis, counterfactual feature inspection, and verified repair for VS Code.",
  "version": "0.1.0",
  "publisher": "your-publisher-id",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "security",
    "vulnerability",
    "sae",
    "counterfactual",
    "repair"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:craftsec.showStatus",
    "onCommand:craftsec.showLogs",
    "onCommand:craftsec.scanCurrentFile",
    "onCommand:craftsec.scanSelection",
    "onCommand:craftsec.scanWorkspace",
    "onCommand:craftsec.explainVulnerability",
    "onCommand:craftsec.analyzeSecurityFeatures",
    "onCommand:craftsec.counterfactualAnalysis",
    "onCommand:craftsec.generateSecureCode",
    "onCommand:craftsec.repairVulnerability",
    "onCommand:craftsec.verifyRepair",
    "onCommand:craftsec.openSecurityDashboard",
    "onView:craftsec.sidebar"
  ],
  "main": "./src/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "craftsec.showStatus",
        "title": "Show Status",
        "category": "CRAFT-Sec"
      },
      {
        "command": "craftsec.showLogs",
        "title": "Show Logs",
        "category": "CRAFT-Sec",
        "icon": "$(output)"
      },
      {
        "command": "craftsec.scanCurrentFile",
        "title": "Scan Current File",
        "category": "CRAFT-Sec"
      },
      {
        "command": "craftsec.scanSelection",
        "title": "Scan Selection",
        "category": "CRAFT-Sec"
      },
      {
        "command": "craftsec.scanWorkspace",
        "title": "Scan Workspace",
        "category": "CRAFT-Sec"
      },
      {
        "command": "craftsec.explainVulnerability",
        "title": "Explain Vulnerability",
        "category": "CRAFT-Sec"
      },
      {
        "command": "craftsec.analyzeSecurityFeatures",
        "title": "Analyze Security Features",
        "category": "CRAFT-Sec"
      },
      {
        "command": "craftsec.counterfactualAnalysis",
        "title": "Counterfactual Analysis",
        "category": "CRAFT-Sec"
      },
      {
        "command": "craftsec.generateSecureCode",
        "title": "Generate Secure Code",
        "category": "CRAFT-Sec"
      },
      {
        "command": "craftsec.repairVulnerability",
        "title": "Repair Vulnerability",
        "category": "CRAFT-Sec"
      },
      {
        "command": "craftsec.verifyRepair",
        "title": "Verify Repair",
        "category": "CRAFT-Sec"
      },
      {
        "command": "craftsec.openSecurityDashboard",
        "title": "Open Security Dashboard",
        "category": "CRAFT-Sec",
        "icon": "$(shield)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "craftsec.showLogs",
          "when": "view == craftsec.sidebar",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "craftsec",
          "title": "CRAFT-Sec",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "craftsec": [
        {
          "id": "craftsec.sidebar",
          "name": "Security Dashboard",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "CRAFT-Sec",
      "properties": {
        "craftsec.backend.url": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "scope": "machine-overridable",
          "pattern": "^https?://[^\\s]+$",
          "markdownDescription": "Base URL of the running CRAFT-Sec FastAPI backend. Use only an HTTP or HTTPS origin with no credentials, path, query, or fragment. The extension appends `/api/v1` itself."
        },
        "craftsec.backend.requestTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 300000,
          "scope": "machine-overridable",
          "description": "Timeout in milliseconds for scan and analysis requests. The request is aborted and reported to the user when it expires."
        },
        "craftsec.backend.healthTimeoutMs": {
          "type": "number",
          "default": 3000,
          "minimum": 500,
          "maximum": 60000,
          "scope": "machine-overridable",
          "description": "Timeout in milliseconds for backend health checks."
        },
        "craftsec.privacy.sendSourceText": {
          "type": "boolean",
          "default": true,
          "scope": "machine-overridable",
          "markdownDescription": "Send the active document text and selected text with explicitly user-invoked scan and analysis commands. Disable to send only file paths and ranges; the backend then reads the saved file from disk. Workspace scans never send file contents. Source text is not sent by health checks or automatically."
        },
        "craftsec.backend.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Reserved for a future backend process manager. The extension currently connects to an already-running backend and does not start one."
        },
        "craftsec.backend.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Reserved for a future backend process manager. The extension currently connects to an already-running backend and does not start one."
        },
        "craftsec.logging.level": {
          "type": "string",
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error",
            "off"
          ],
          "enumDescriptions": [
            "Show trace, debug, info, warning, and error messages.",
            "Show debug, info, warning, and error messages.",
            "Show info, warning, and error messages.",
            "Show warning and error messages.",
            "Show error messages only.",
            "Disable CRAFT-Sec output channel messages."
          ],
          "default": "info",
          "description": "Log level for the CRAFT-Sec output channel."
        },
        "craftsec.ui.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Show the CRAFT-Sec status bar item."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --ignore-path ../.prettierignore --write \"**/*.{js,json,css,html,yml,yaml}\"",
    "format:check": "prettier --ignore-path ../.prettierignore --check \"**/*.{js,json,css,html,yml,yaml}\"",
    "test": "node --test test/unit/*.test.js",
    "test:integration": "node test/integration/runTest.js",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
