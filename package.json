{
  "name": "craft-sec-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "CRAFT-Sec monorepo: VS Code extension and Python security engine",
  "workspaces": [
    "vscode-extension"
  ],
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "setup": "node scripts/dev.js setup",
    "doctor": "node scripts/dev.js doctor",
    "lint": "node scripts/dev.js lint",
    "format": "node scripts/dev.js format",
    "format:check": "node scripts/dev.js format-check",
    "test": "node scripts/dev.js test",
    "build": "node scripts/dev.js build",
    "check": "node scripts/dev.js check",
    "structure:check": "node scripts/dev.js structure-check",
    "extension:lint": "npm --workspace vscode-extension run lint",
    "extension:test": "npm --workspace vscode-extension run test"
  }
}
